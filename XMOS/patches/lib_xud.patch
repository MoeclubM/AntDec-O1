@@ -3,6 +3,34 @@
 
 #include "xud.h"
 #include "XUD_USB_Defines.h"
+#include <xcore/hwtimer.h>
+#include <xcore/select.h>
+
+unsigned XUD_UserSetupIdleInterval(void) __attribute__((weak));
+unsigned XUD_UserSetupIdleInterval(void) { return 0u; }
+void XUD_UserSetupIdle(void) __attribute__((weak));
+void XUD_UserSetupIdle(void) { }
+void XUD_UserSetupIdleUnavailable(void) __attribute__((weak));
+void XUD_UserSetupIdleUnavailable(void) { }
+
+static void wait_setup_idle(unsigned client_chanend)
+{
+    unsigned interval = XUD_UserSetupIdleInterval();
+    if (!interval) return;
+    hwtimer_t timer = hwtimer_alloc();
+    if (!timer) { XUD_UserSetupIdleUnavailable(); return; }
+    hwtimer_set_trigger_time(timer, hwtimer_get_time(timer) + interval);
+    SELECT_RES_ORDERED(CASE_THEN(client_chanend, setup_ready), CASE_THEN(timer, idle_tick)) {
+    setup_ready:
+        break;
+    idle_tick:
+        hwtimer_clear_trigger_time(timer);
+        XUD_UserSetupIdle();
+        hwtimer_set_trigger_time(timer, hwtimer_get_time(timer) + interval);
+        continue;
+    }
+    hwtimer_clear_trigger_time(timer); hwtimer_free(timer);
+}
 
 extern XUD_ep_info ep_info[USB_MAX_NUM_EP];
 
