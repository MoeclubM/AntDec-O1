<?xml version="1.0" encoding="UTF-8"?>
<Network xmlns="http://www.xmos.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.xmos.com http://www.xmos.com">
  <Type>Board</Type>
  <Name>AntDec O1 XU316 Audio Board</Name>

  <Declarations>
    <Declaration>tileref tile[2]</Declaration>
  </Declarations>

  <Packages>
    <Package id="0" Type="XS3-UnA-1024-QF60B">
      <Nodes>
        <Node Id="0" InPackageId="0" Type="XS3-L16A-1024" Oscillator="24MHz" SystemFrequency="600MHz" ReferenceFrequency="100MHz">
          <Boot>
            <Source Location="bootFlash"/>
          </Boot>
          <Tile Number="0" Reference="tile[0]">
            <!-- W25Q16JVSSIQ Quad-SPI Boot Flash (U205) -->
            <Port Location="XS1_PORT_1B" Name="PORT_SQI_CS"/>
            <Port Location="XS1_PORT_1C" Name="PORT_SQI_SCLK"/>
            <Port Location="XS1_PORT_4B" Name="PORT_SQI_SIO"/>

            <!-- Master Clock Input & Async Feedback Counter -->
            <Port Location="XS1_PORT_1A" Name="PORT_MCLK_IN_USB"/>
            <Port Location="XS1_PORT_1D" Name="PORT_MCLK_COUNT"/>

            <!-- Baseboard Status & STM32 Bidirectional Single-Wire Link (J203 -> J6) -->
            <Port Location="XS1_PORT_1M" Name="PORT_PLUGGED"/>
            <Port Location="XS1_PORT_1N" Name="PORT_STM32_TX"/>
            <Port Location="XS1_PORT_1O" Name="PORT_STM32_RX"/>
            <Port Location="XS1_PORT_1P" Name="PORT_DSD64_128"/>
            <Port Location="XS1_PORT_8D" Name="PORT_FS_STATUS"/>
          </Tile>
          <Tile Number="1" Reference="tile[1]">
            <!-- Dual Oscillator Select (Q201: bit3=0 -> Y202 49.152MHz, bit3=1 -> Y203 45.1584MHz) -->
            <Port Location="XS1_PORT_4A" Name="PORT_CLK_SEL"/>

            <!-- MCLK input is before RN1; DAC clock branch: RN1 -> J203.12 -> J6.11 -> R29 -> ES9039Q2M.32 -->
            <!-- I2S / Native DSD outputs also pass through RN1 and the board connector. -->
            <Port Location="XS1_PORT_1D" Name="PORT_MCLK_IN"/>
            <Port Location="XS1_PORT_1F" Name="PORT_I2S_DAC0"/>
            <Port Location="XS1_PORT_1G" Name="PORT_I2S_BCLK"/>
            <Port Location="XS1_PORT_1K" Name="PORT_I2S_LRCLK"/>
          </Tile>
        </Node>
      </Nodes>
    </Package>
  </Packages>

  <ExternalDevices>
    <Device NodeId="0" Tile="0" Class="SQIFlash" Name="bootFlash" PageSize="256" SectorSize="4096" NumPages="8192">
      <Attribute Name="PORT_SQI_CS" Value="PORT_SQI_CS"/>
      <Attribute Name="PORT_SQI_SCLK" Value="PORT_SQI_SCLK"/>
      <Attribute Name="PORT_SQI_SIO" Value="PORT_SQI_SIO"/>
    </Device>
  </ExternalDevices>

  <JTAGChain>
    <JTAGDevice NodeId="0"/>
  </JTAGChain>
</Network>
